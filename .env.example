# ─── WhatsApp (Meta Cloud API) ────────────────────────────────────────────────
META_ACCESS_TOKEN=     # Token permanente del usuario del sistema (nunca caduca)
META_PHONE_NUMBER_ID=  # ID del número de teléfono en Meta for Developers
META_VERIFY_TOKEN=     # Token que inventás vos para verificar el webhook

# ─── IA ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=     # De console.anthropic.com

# ─── Audio (opcional — para transcribir mensajes de voz) ─────────────────────
GROQ_API_KEY=          # De console.groq.com (plan free alcanza)

# ─── Notificaciones a Braian ──────────────────────────────────────────────────
OWNER_WHATSAPP_NUMBER= # Tu número con código de país, sin + (ej: 59898648853)

# ─── Google Calendar ──────────────────────────────────────────────────────────
GOOGLE_CALENDAR_ID=    # Tu Gmail (ej: iadatabraian@gmail.com)
GOOGLE_SERVICE_ACCOUNT_JSON=  # JSON completo de la service account (ver README)
